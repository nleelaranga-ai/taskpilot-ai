{
  "name": "taskpilot-ai",
  "version": "1.0.0",
  "description": "Voice-style task assistant powered by a real Model Context Protocol (MCP) server over Streamable HTTP and SQLite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:mcp\" \"npm run dev:web\"",
    "dev:mcp": "node mcp-server/server.mjs",
    "dev:web": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node mcp-server/test-e2e.mjs && npx tsx tests/planner.test.ts",
    "test:mcp": "node mcp-server/test-e2e.mjs",
    "test:planner": "npx tsx tests/planner.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.758.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^11.8.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.475.0",
    "next": "14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
