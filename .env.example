# TaskPilot AI Environment Configuration

# --- Server Ports & URLs ---
PORT=3000
MCP_PORT=3333

# For Local Development:
MCP_SERVER_URL=http://127.0.0.1:3333/mcp
TASKPILOT_MCP_URL=http://127.0.0.1:3333/mcp

# For Vercel Production Deployment:
# Point to your deployed Render MCP Server URL:
# TASKPILOT_MCP_URL=https://taskpilot-mcp-server.onrender.com/mcp
# NEXT_PUBLIC_APP_URL=https://taskpilot-ai.vercel.app

# --- SQLite Database Configuration ---
# Defaults to data/taskpilot.db if omitted.
# On Render with a persistent disk mount, set to:
# TASKPILOT_DB=/data/taskpilot.db
TASKPILOT_DB=data/taskpilot.db

# --- Security & CORS Configuration ---
# Comma-separated list of extra allowed origins, or * for all
# ALLOWED_ORIGINS=https://taskpilot-ai.vercel.app,http://localhost:3000

# --- Optional: AWS Bedrock Planner Configuration ---
# Only required if you wish to use the optional Bedrock planner instead of the offline deterministic planner
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
